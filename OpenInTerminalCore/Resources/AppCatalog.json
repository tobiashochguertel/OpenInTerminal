{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "terminal",
      "name": "Terminal",
      "type": "terminal",
      "bundleId": "com.apple.Terminal",
      "open": {
        "argv": [
          "-a",
          "Terminal"
        ],
        "pathMode": "appendFirst"
      },
      "options": {
        "newInstance": {
          "type": "choice",
          "label": "Open in",
          "default": "window",
          "choices": [
            {
              "value": "window",
              "label": "Window"
            },
            {
              "value": "tab",
              "label": "Tab",
              "open": {
                "argv": [
                  "-a",
                  "Terminal"
                ],
                "script": "terminalNewTabScript"
              }
            }
          ]
        }
      }
    },
    {
      "id": "iterm2",
      "name": "iTerm",
      "type": "terminal",
      "bundleId": "com.googlecode.iterm2",
      "open": {
        "argv": [
          "-a",
          "iTerm"
        ],
        "pathMode": "appendFirst"
      },
      "options": {
        "newInstance": {
          "type": "choice",
          "label": "Open in",
          "default": "window",
          "choices": [
            {
              "value": "window",
              "label": "Window",
              "apply": {
                "defaultsWrite": {
                  "domain": "com.googlecode.iterm2",
                  "key": "OpenFileInNewWindows",
                  "value": true
                }
              }
            },
            {
              "value": "tab",
              "label": "Tab",
              "apply": {
                "defaultsWrite": {
                  "domain": "com.googlecode.iterm2",
                  "key": "OpenFileInNewWindows",
                  "value": false
                }
              }
            }
          ]
        }
      }
    },
